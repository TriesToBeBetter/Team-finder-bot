# ===============================================
# TeamFinder Telegram Bot Configuration
# ===============================================

# Telegram Bot Token obtained from @BotFather (format: 123456789:ABCDefgh...)
BOT_TOKEN=7123456789:AAHxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Telegram User IDs of administrators (comma-separated numbers, e.g. 123456789,987654321)
# Use @userinfobot or @getmyid_bot in Telegram to get your numeric user ID
ADMIN_IDS=123456789

# Optional dedicated Telegram Chat or Group ID for receiving application review cards
# ADMIN_CHAT_ID=-1001234567890

# Database URL
# For SQLite local development:
DATABASE_URL=sqlite+aiosqlite:///teamfinder.db
# For PostgreSQL production deployment:
# DATABASE_URL=postgresql+asyncpg://postgres:password@localhost:5432/teamfinder

# Optional Google Gemini API Key for assistive candidate resume structuring
# GEMINI_API_KEY=AIzaSy...

# Logging Level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
